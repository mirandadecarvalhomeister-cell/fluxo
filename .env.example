VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica
VITE_LIVEKIT_URL=wss://seu-projeto.livekit.cloud
# opcional: host do Ingress RTMP do LiveKit, exibido no modal de transmissão com OBS
VITE_LIVEKIT_INGRESS_URL=rtmps://seu-ingress.livekit.cloud:1935/x

# Arena do Caos (Jogos Online). URL WS/WSS do servidor Colyseus e HTTP/HTTPS
# correspondente para listar/descobrir salas públicas.
# Em desenvolvimento local: ws://localhost:2567 e http://localhost:2567
VITE_ARENA_URL=
VITE_ARENA_HTTP_URL=

# Servidor da Arena (server/index.js) — configurar no ambiente do servidor,
# não no cliente. Necessários para validar identidade e persistir resultados.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# ARENA_ALLOWED_ORIGIN=https://seu-fluxo.app
# PORT=2567
