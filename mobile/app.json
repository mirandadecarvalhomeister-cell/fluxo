{
  "expo": {
    "name": "Fluxo",
    "slug": "fluxo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "fluxo",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#05060a",
    "newArchEnabled": true,
    "assetBundlePatterns": ["**/*"],
    "android": {
      "package": "app.fluxo.mobile",
      "versionCode": 1,
      "predictiveBackGestureEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#05060a"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.INTERNET",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "vibefluxo.com", "pathPrefix": "/" },
            { "scheme": "https", "host": "www.vibefluxo.com", "pathPrefix": "/" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      [
        "expo-status-bar",
        {
          "style": "light"
        }
      ],
      [
        "expo-navigation-bar",
        {
          "style": "light",
          "enforceContrast": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Fluxo acessa suas fotos e vídeos para você publicar e enviar no chat.",
          "cameraPermission": "O Fluxo usa a câmera para você fotografar, gravar vídeos e iniciar lives.",
          "microphonePermission": "O Fluxo usa o microfone nas lives e nos vídeos."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#8b5cf6"
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": true
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "00000000-0000-0000-0000-000000000000"
      }
    }
  }
}
