# Servidor da Arena do Caos (Colyseus). Copie para .env e preencha.
# NÃO comite este arquivo com valores reais.

# Porta interna do servidor. Em produção fica atrás do Caddy (HTTPS).
PORT=2567
# Em produção, escute só no localhost e deixe o Caddy expor 80/443.
HOST=127.0.0.1

# Supabase (os mesmos do cliente). A service_role é SECRETA: só existe aqui.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=sua-chave-anon-publica
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role

# Origem permitida para CORS. Use o domínio do FluXo. Use * só em dev.
ARENA_ALLOWED_ORIGIN=https://seu-fluxo.app
